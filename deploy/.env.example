# DeckSmith 部署配置模板 —— 复制为 .env 后填写。.env 已被 .dockerignore 与 git 排除，不进镜像。
#
# ⚠️ 这套系统没有离线退路：两个输出引擎都要拉起 claude CLI 并出网调用模型
# （ADR-011 决策 2 已确认不保留纯 Python 兜底实现）。下面三项为空 = 产品不可用。

# ── 模型接入（必填，二选一种鉴权方式）──
# 两种鉴权头不等价，按你的端点要求填**其中一个**：
#   ANTHROPIC_API_KEY   → 发 `x-api-key` 头（官方 Anthropic 与多数兼容网关）
#   ANTHROPIC_AUTH_TOKEN → 发 `Authorization: Bearer` 头（第三方兼容网关常见）
# 填错类型不会报"缺 key"，而是表现为任务十几秒即失败、会话日志里是
# authentication_failed —— 先试 API_KEY，报鉴权错就换 AUTH_TOKEN。
ANTHROPIC_API_KEY=
# ANTHROPIC_AUTH_TOKEN=

# 端点地址。留空 = 走官方 api.anthropic.com；自建/第三方网关必须填。
ANTHROPIC_BASE_URL=
# 模型名，须与端点支持的名称一致（网关侧模型名常与官方不同）。
ANTHROPIC_MODEL=

# ⚠️ 用第三方网关时下面三项**也要填**，否则填对 key 仍会失败：
#    claude 内部还按 sonnet/opus/haiku 三档挑模型，默认值是 `claude-*` 官方模型名，
#    第三方网关上不存在这些名字，命中那几档调用就会报错。全部指到网关自己的模型名即可。
#    （实测：这些变量名硬编码在 claude 原生二进制里，容器内无需 settings.json。）
ANTHROPIC_DEFAULT_SONNET_MODEL=
ANTHROPIC_DEFAULT_OPUS_MODEL=
ANTHROPIC_DEFAULT_HAIKU_MODEL=

# ⚠️ 改完本文件必须重建容器才生效：env_file 只在容器创建时读取一次。
#    docker compose up -d --force-recreate app
#    验证是否注入成功：docker compose exec app env | grep -c ANTHROPIC
#
# 关于 settings.json：容器内**不需要**它来配鉴权与模型（上面的环境变量已够，实测二进制
# 直接读取）。若你的部署还想预置"已完成首次引导"，可挂载
# /data/home/.claude/settings.json 内容为 {"hasCompletedOnboarding": true}；
# 本项目首次任务实测未因引导被卡住，故不作默认要求。

# ── 版本与端口 ──
# compose 故意不给镜像标签兜底：写死默认会把人静默引向旧版本；且标签指向的镜像不存在时
# compose 会转头去构建（离线环境随即失败）。每次发版请同步更新 IMAGE_TAG。
#   本地构建：        docker compose up -d --build
#   离线导入后启动：  docker compose up -d --no-build      ← 见安装说明第九节
IMAGE_TAG=0.6.1

# claude CLI 版本（构建期参数）。不钉住则每次构建取 npm 当时的最新版，等于静默更换生成
# 引擎的实际执行者（实测 npm 注册表 2.1.272 / 镜像 2.1.197 / 开发机 CLI 2.1.105 三处各异）。
# 默认值是在 Debian 12 虚拟机上端到端出片验证过的版本；改它需重新验证。
CLAUDE_VERSION=2.1.197

# 宿主机上 web 的监听端口；容器内固定 3000
WEB_PORT=3000

# ── 内网/代理（选填）──
# 客户环境若只能走代理出网，取消注释（compose 会透传给 app 容器，
# claude CLI 与 Python 侧均读取这组变量）
# HTTPS_PROXY=http://10.0.0.5:3128
# NO_PROXY=localhost,127.0.0.1
