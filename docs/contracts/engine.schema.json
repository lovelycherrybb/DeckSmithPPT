{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Engine": {
      "type": "object",
      "description": "引擎（与 vc_design/objects/01-引擎-Engine.md 对齐）。生成演示文件的封闭产品。",
      "required": [
        "name",
        "display_name",
        "engine_type"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "引擎名称（唯一标识）"
        },
        "display_name": {
          "type": "string",
          "description": "引擎显示名称（用户可见）"
        },
        "description": {
          "type": "string",
          "description": "引擎描述"
        },
        "engine_type": {
          "$ref": "#/$defs/EngineType",
          "description": "引擎类型"
        },
        "params_schema": {
          "type": "object",
          "description": "引擎参数说明书（JSON Schema），前端据此渲染表单",
          "additionalProperties": true
        }
      }
    },
    "EngineType": {
      "type": "string",
      "enum": [
        "draft",
        "output"
      ],
      "description": "引擎类型：draft=草稿生成引擎，output=输出引擎"
    },
    "Project": {
      "type": "object",
      "description": "项目（与 vc_design/objects/04-项目-Project.md 对齐）。单个演示文件生成项目，是系统的顶层聚合根。",
      "required": [
        "project_id",
        "project_name",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "project_id": {
          "type": "string",
          "description": "项目标识（唯一）"
        },
        "project_name": {
          "type": "string",
          "description": "项目名称（用户可见）"
        },
        "current_draft_id": {
          "type": "string",
          "description": "当前草稿标识（用户正在编辑的草稿）"
        },
        "current_draft_version": {
          "type": "string",
          "description": "当前草稿版本（用户正在编辑的版本）",
          "pattern": "^[0-9]{14}$"
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "创建时间（ISO 8601）"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "description": "最后更新时间（ISO 8601）"
        }
      }
    },
    "Draft": {
      "type": "object",
      "description": "草稿聚合（与 vc_design/objects/02-草稿-Draft.md 对齐）。管理同一草稿的多个版本。",
      "required": [
        "draft_id",
        "project_id",
        "task_id",
        "current_version",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "draft_id": {
          "type": "string",
          "description": "草稿标识（唯一）"
        },
        "project_id": {
          "type": "string",
          "description": "所属项目标识"
        },
        "task_id": {
          "type": "string",
          "description": "生成此草稿的草稿引擎任务标识"
        },
        "current_version": {
          "type": "string",
          "description": "当前版本号（年月日时分秒格式）",
          "pattern": "^[0-9]{14}$"
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "创建时间（ISO 8601）"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "description": "最后更新时间（ISO 8601）"
        }
      }
    },
    "DraftVersion": {
      "type": "object",
      "description": "草稿版本记录（与 vc_design 对齐）。每个版本有唯一的内容和版本号。",
      "required": [
        "draft_id",
        "task_id",
        "version",
        "content",
        "draft_path",
        "created_at"
      ],
      "properties": {
        "draft_id": {
          "type": "string",
          "description": "草稿标识（同一草稿的所有版本共享此标识）"
        },
        "project_id": {
          "type": "string",
          "description": "所属项目标识"
        },
        "task_id": {
          "type": "string",
          "description": "生成任务（哪个草稿引擎任务创建的）"
        },
        "version": {
          "type": "string",
          "description": "版本号（格式：年月日时分秒，如 20260907143025）。同一草稿同一秒内只能有一个版本。",
          "pattern": "^[0-9]{14}$"
        },
        "content": {
          "type": "string",
          "description": "草稿内容（Markdown 格式）"
        },
        "draft_path": {
          "type": "string",
          "description": "草稿文件路径（服务器上的存储位置）"
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "创建时间（ISO 8601）"
        }
      }
    },
    "Presentation": {
      "type": "object",
      "description": "演示文件（与 vc_design/objects/05-演示文件-Presentation.md 对齐）。输出引擎任务生成的最终展示文件。",
      "required": [
        "presentation_id",
        "project_id",
        "task_id",
        "file_name",
        "file_format",
        "file_path",
        "created_at"
      ],
      "properties": {
        "presentation_id": {
          "type": "string",
          "description": "文件标识（唯一）"
        },
        "project_id": {
          "type": "string",
          "description": "所属项目标识"
        },
        "task_id": {
          "type": "string",
          "description": "生成任务（哪个输出引擎任务创建的）"
        },
        "file_name": {
          "type": "string",
          "description": "文件名称（默认为项目名称_年月日时分秒）"
        },
        "file_format": {
          "type": "string",
          "description": "文件格式（PPTX、HTML等）",
          "enum": [
            "pptx",
            "html"
          ]
        },
        "file_path": {
          "type": "string",
          "description": "文件路径（服务器上的存储位置）"
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "创建时间（ISO 8601）"
        }
      }
    },
    "DeckContent": {
      "type": "object",
      "description": "提交给引擎的生成请求（通用层，与 openapi.yaml 的 DeckRequest 一致）。engine_params 可在提交阶段一并提供。",
      "required": [
        "engine",
        "engine_type"
      ],
      "properties": {
        "title": {
          "type": "string",
          "description": "PPT 标题（可选，可从源材料提取或由 AI 自动生成）"
        },
        "content": {
          "type": "string",
          "description": "Markdown 内容。输出引擎任务可直接提供，或通过 draft_id + version 引用草稿实体。最多15000字符。",
          "maxLength": 15000
        },
        "draft_id": {
          "type": "string",
          "description": "草稿标识（输出引擎任务可选）。提供后系统自动从草稿版本中获取 content，无需手动传 content。"
        },
        "version": {
          "type": "string",
          "description": "草稿版本号（与 draft_id 配合使用）。不提供则使用草稿的当前版本。",
          "pattern": "^[0-9]{14}$"
        },
        "pages": {
          "type": "integer",
          "minimum": 1,
          "description": "目标页数（可选，可由 AI 决定或使用默认值）"
        },
        "engine": {
          "type": "string",
          "enum": [
            "ppt_master",
            "claude_draft",
            "ppt_master_draft",
            "guizang_ppt"
          ],
          "description": "选择哪个引擎（注册表里的名字，与 GET /api/engines 返回的 name 一致）"
        },
        "engine_type": {
          "$ref": "#/$defs/EngineType",
          "description": "引擎类型：draft=草稿引擎任务，output=输出引擎任务"
        },
        "agent": {
          "type": "string",
          "enum": [
            "claude",
            "codex",
            "hermes"
          ],
          "default": "claude",
          "description": "驱动引擎的 AI agent（通用层，可选）。claude=Claude Code；codex=Codex CLI；hermes=Hermes"
        },
        "content_style": {
          "type": "string",
          "default": "marketing_promo",
          "description": "内容风格（产品层选择，供草稿重写使用）"
        },
        "sources": {
          "type": "array",
          "description": "原始素材来源列表（提交时提供，用于生成草稿）。优先于 content。支持多文件上传。",
          "items": {
            "type": "object",
            "required": [
              "type",
              "value"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "url",
                  "file_path",
                  "text"
                ],
                "description": "url=网页链接；file_path=上传返回的 path；text=直接文本"
              },
              "value": {
                "type": "string",
                "description": "URL / 上传返回的 path / 文本内容"
              }
            }
          }
        },
        "engine_params": {
          "type": "object",
          "description": "提交阶段选择的引擎参数（与 /api/engines 返回的 params_schema 对齐）。",
          "additionalProperties": true
        }
      }
    },
    "JobStatus": {
      "type": "string",
      "description": "任务状态（与 vc_design 一致：只有4种状态）",
      "enum": [
        "running",
        "timeout",
        "failed",
        "completed"
      ]
    },
    "TaskType": {
      "type": "string",
      "enum": [
        "draft",
        "output"
      ],
      "description": "任务类型：draft=草稿引擎任务，output=输出引擎任务"
    },
    "TokenUsage": {
      "type": "object",
      "description": "引擎任务上报的 LLM token 消耗（分项 + 派生总数）。口径见 ADR-016：只统计该任务的引擎主会话，同一任务 --resume 断点续跑产生的多个 result 事件按分项累加而非覆盖；后端辅助 agent（拟题、草稿改写/编辑）的消耗不计入。数据源为 claude CLI stream-json 的 result 事件 usage（整段会话累计值，非末轮快照）。分项逐项可空：第三方 Anthropic 兼容网关可能不回报 cache_* 字段。四项全缺时引擎应整体不填本对象（而非填 0），语义是「未记录」。",
      "required": [
        "total_tokens"
      ],
      "properties": {
        "input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "description": "非缓存的新增输入 token；引擎/网关未回报时为 null"
        },
        "cache_creation_input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "description": "写入 prompt cache 的输入 token；未回报时为 null"
        },
        "cache_read_input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "description": "命中 prompt cache 读到的输入 token（多轮会话里量级远大于新增输入，须与 input_tokens 分列）；未回报时为 null"
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "description": "输出 token；未回报时为 null"
        },
        "total_tokens": {
          "type": "integer",
          "description": "派生总数 = input + cache_creation + cache_read + output（缺报项按 0 参与求和），与 claude CLI 自身对输入总量的算法一致。四项全缺时不产出本对象，避免出现假的 0。"
        }
      }
    },
    "Job": {
      "type": "object",
      "description": "引擎任务。任务类型：草稿引擎任务（调用草稿生成引擎，将用户文件转化为 Markdown 草稿）和输出引擎任务（调用输出引擎，将草稿内容生成最终展示文件）。状态明细（status_detail）仅在 running 状态下有意义，内容随执行进度变化，前端通过轮询获取最新状态。",
      "required": [
        "job_id",
        "status",
        "task_type"
      ],
      "properties": {
        "job_id": {
          "type": "string",
          "description": "任务唯一 ID"
        },
        "project_id": {
          "type": "string",
          "description": "所属项目标识"
        },
        "task_type": {
          "$ref": "#/$defs/TaskType",
          "description": "任务类型：draft=草稿引擎任务，output=输出引擎任务"
        },
        "status": {
          "$ref": "#/$defs/JobStatus"
        },
        "status_detail": {
          "type": "string",
          "description": "状态明细（引擎当前正在做什么，仅 running 时有意义）。前端通过轮询获取最新状态。"
        },
        "engine_job_id": {
          "type": "string",
          "description": "引擎任务编号（用于查询 Agent 执行状态，即 Agent 的会话标识）。非 Agent 类引擎可为空。"
        },
        "title": {
          "type": "string",
          "description": "PPT 标题（可选，可从源材料提取或由 AI 自动生成）"
        },
        "pages": {
          "type": "integer",
          "description": "目标页数"
        },
        "engine": {
          "type": "string",
          "description": "选择的引擎"
        },
        "agent": {
          "type": "string",
          "description": "驱动引擎的 AI agent"
        },
        "content_style": {
          "type": "string",
          "description": "内容风格（用于草稿重写和内容表达）"
        },
        "engine_params": {
          "type": "object",
          "description": "提交/确认阶段使用的引擎参数",
          "additionalProperties": true
        },
        "result_path": {
          "type": "string",
          "description": "生成的 PPTX 文件路径（completed 后非空）"
        },
        "draft_content": {
          "type": "string",
          "description": "草稿 Markdown 内容（已废弃，使用 Draft 实体）"
        },
        "error": {
          "type": "string",
          "description": "失败/超时原因（仅 failed/timeout 时有值）"
        },
        "token_usage": {
          "$ref": "#/$defs/TokenUsage",
          "description": "本任务引擎主会话累计的 LLM token 消耗。引擎未上报（含历史任务）时整体缺省或为 null，后端与界面显示「未记录」，禁止填 0 或估算值。"
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "任务创建时间（ISO 8601）"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "description": "任务最后更新时间（ISO 8601）"
        }
      }
    },
    "DraftEngine": {
      "type": "object",
      "description": "草稿引擎接口（将用户文件转化为 Markdown 草稿）",
      "properties": {
        "sources": {
          "type": "array",
          "description": "原始素材来源列表",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "url",
                  "file_path",
                  "text"
                ]
              },
              "value": {
                "type": "string"
              }
            }
          }
        },
        "content": {
          "type": "string",
          "description": "直接提供的文本内容（可选）"
        },
        "title": {
          "type": "string",
          "description": "标题（可选）"
        },
        "engine_params": {
          "type": "object",
          "description": "引擎特定参数",
          "additionalProperties": true
        }
      }
    },
    "OutputEngine": {
      "type": "object",
      "description": "输出引擎接口（将 Markdown 内容生成最终展示文件）",
      "x-runtime-hooks": {
        "prepare_runtime": {
          "optional": true,
          "signature": "prepare_runtime(job_dir: Path | None = None) -> str | None",
          "description": "可选钩子：备齐本引擎跑一个任务所需的运行前置条件（如把仓库内技能目录软链到 Claude 的技能发现目录、校验技能脚本所需解释器与依赖）。由调用方在启动期与提交任务前遍历注册表逐个调用，探测方式与 get_pages 相同（沿 MRO 判真实实现，不按引擎名分支），因此新增引擎不必改动 entrypoint 或后端任何调用方。job_dir 传 None 表示启动期预检、传具体任务目录表示任务前检查。",
          "semantics": {
            "None": "前置条件齐备",
            "string": "可降级的告警（任务仍可尝试），文本为人读描述，进日志与 run.log",
            "raises": "硬缺失：该引擎在当前环境不可运行。调用方须把它计为失败而非告警"
          },
          "idempotent": true,
          "notes": "产物落点须位于调用方分配的 job_dir 内（ADR-012 决策 3）；本钩子的 job_dir 入参即该落点契约的前向接入点，将来若升级为强制契约无需改签名。"
        }
      },
      "properties": {
        "content": {
          "type": "string",
          "description": "草稿的 Markdown 内容（最多15000字符）"
        },
        "title": {
          "type": "string",
          "description": "PPT 标题（可选）"
        },
        "pages": {
          "type": "integer",
          "description": "目标页数（可选）"
        },
        "engine_params": {
          "type": "object",
          "description": "引擎特定参数（风格/模式/尺寸等）",
          "additionalProperties": true
        }
      }
    },
    "ppt_master": {
      "type": "object",
      "description": "ppt_master 引擎在 engine_params 中支持的参数。中文说明见 docs/contracts/style-guide.md。此定义即 GET /api/engines 返回的 params_schema 内容。",
      "properties": {
        "style": {
          "type": "string",
          "description": "视觉风格（18 种）。中文说明见 docs/contracts/style-guide.md",
          "enum": [
            "swiss-minimal",
            "soft-rounded",
            "glassmorphism",
            "dark-tech",
            "blueprint",
            "editorial",
            "photo-editorial",
            "data-journalism",
            "brutalist",
            "chalkboard",
            "ink-notes",
            "ink-wash",
            "memphis",
            "paper-cut",
            "pixel-art",
            "sketch-notes",
            "vintage-poster",
            "zine"
          ]
        },
        "mode": {
          "type": "string",
          "description": "叙事模式（auto=由引擎自动决定）。中文说明见 docs/contracts/style-guide.md",
          "enum": [
            "auto",
            "pyramid",
            "narrative",
            "instructional",
            "showcase",
            "briefing"
          ],
          "default": "auto"
        },
        "format": {
          "type": "string",
          "description": "画布/输出尺寸（默认 ppt169）。中文说明见 docs/contracts/style-guide.md",
          "enum": [
            "ppt169",
            "ppt43",
            "xiaohongshu",
            "moments",
            "story",
            "wechat",
            "banner",
            "a4"
          ],
          "default": "ppt169"
        },
        "notes": {
          "type": "boolean",
          "default": false,
          "description": "是否生成演讲备注"
        },
        "animation": {
          "type": "string",
          "enum": [
            "none",
            "auto"
          ],
          "default": "none",
          "description": "动画：none=关，auto=自动"
        }
      }
    },
    "ppt_master_v6": {
      "type": "object",
      "description": "ppt_master_v6 引擎（专供上游 ppt-master v6.6.0 技能）在 engine_params 中支持的参数。中文说明见 docs/contracts/style-guide.md。此定义即 GET /api/engines 返回的 params_schema 内容。与 ppt_master 的差异：全量接线 v6.6 的路由 profile、生成模式与打包结构。",
      "properties": {
        "style": {
          "type": "string",
          "description": "视觉风格（18 种，与 ppt_master 同集）。中文说明见 docs/contracts/style-guide.md",
          "enum": [
            "swiss-minimal",
            "soft-rounded",
            "glassmorphism",
            "dark-tech",
            "blueprint",
            "editorial",
            "photo-editorial",
            "data-journalism",
            "brutalist",
            "chalkboard",
            "ink-notes",
            "ink-wash",
            "memphis",
            "paper-cut",
            "pixel-art",
            "sketch-notes",
            "vintage-poster",
            "zine"
          ]
        },
        "mode": {
          "type": "string",
          "description": "叙事模式（auto=由引擎自动决定）。中文说明见 docs/contracts/style-guide.md",
          "enum": [
            "auto",
            "pyramid",
            "narrative",
            "instructional",
            "showcase",
            "briefing"
          ],
          "default": "auto"
        },
        "format": {
          "type": "string",
          "description": "画布/输出尺寸（默认 ppt169）。中文说明见 docs/contracts/style-guide.md",
          "enum": [
            "ppt169",
            "ppt43",
            "xiaohongshu",
            "moments",
            "story",
            "wechat",
            "banner",
            "a4"
          ],
          "default": "ppt169"
        },
        "notes": {
          "type": "boolean",
          "default": false,
